---
import { acquisitionMailto } from '../consts';

interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'gradient' | 'outline';
  class?: string;
  subject?: string;
}

const { label, variant = 'primary', class: className = '', subject } = Astro.props;
const href = acquisitionMailto(subject);

const variants = {
  primary:
    'bg-white text-[#0a0a0f] hover:bg-white/90 shadow-2xl shadow-white/20 font-extrabold',
  secondary:
    'border border-white/20 hover:border-white/70 text-lg transition-all',
  gradient:
    'bg-gradient-to-r from-[#22f5ff] to-[#a855f7] text-[#0a0a0f] font-extrabold shadow-[0_0_60px_rgba(34,245,255,0.35)] hover:scale-[1.015] active:scale-[0.985]',
  outline:
    'border border-white text-white font-extrabold hover:bg-white hover:text-black transition-all',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-x-3 rounded-3xl px-8 py-4 text-sm transition-all sm:text-base min-h-[44px]',
    variants[variant],
    className,
  ]}
>
  <span>{label}</span>
  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>
