---
import { acquisitionMailto } from '../consts';

const mailto = acquisitionMailto('aiwaitress.com — Make an Offer');
---

<div
  id="mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-[#0a0a0f]/95 backdrop-blur-md transition-transform duration-300 md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <div class="min-w-0">
      <div class="text-[10px] font-medium uppercase tracking-[1.5px] text-white/55">Asking price</div>
      <div class="truncate text-lg font-semibold tracking-tight text-white">
        $8,888 <span class="text-sm font-normal text-white/55">USD</span>
      </div>
    </div>
    <a
      href={mailto}
      class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-x-2 rounded-2xl bg-gradient-to-r from-[#22f5ff] to-[#a855f7] px-5 text-sm font-extrabold text-[#0a0a0f] transition-all active:scale-[0.985]"
    >
      <span>Make an offer</span>
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</div>
