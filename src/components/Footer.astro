---
import { SITE, acquisitionMailto } from '../consts';
import AcquisitionCTA from './AcquisitionCTA.astro';

const mailto = acquisitionMailto('aiwaitress.com — Domain Acquisition');
---

<footer id="acquire" class="border-t border-white/10 bg-[#0a0a0f]">
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(34,245,255,0.12),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 py-20">
      <div class="glass rounded-[2rem] border border-[#22f5ff]/20 p-8 md:p-12">
        <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
          <div>
            <p class="mb-3 text-xs font-black tracking-[3px] text-[#22f5ff] uppercase">
              Domain available for acquisition
            </p>
            <h2 class="font-display text-4xl tracking-tight md:text-5xl">
              Own <span class="domain-gradient">aiwaitress.com</span>
            </h2>
            <p class="mt-4 max-w-xl text-lg text-white/70">
              Serious buyers only. Direct to owner — no brokers. Escrow-ready transfer with flexible terms for
              qualified acquirers.
            </p>
            <dl class="mt-8 grid gap-4 sm:grid-cols-3">
              <div class="rounded-2xl border border-white/10 bg-black/40 px-4 py-3">
                <dt class="text-[10px] tracking-widest text-white/40 uppercase">Asset</dt>
                <dd class="mt-1 font-semibold text-white">aiwaitress.com</dd>
              </div>
              <div class="rounded-2xl border border-white/10 bg-black/40 px-4 py-3">
                <dt class="text-[10px] tracking-widest text-white/40 uppercase">Status</dt>
                <dd class="mt-1 font-semibold text-emerald-400">Available now</dd>
              </div>
              <div class="rounded-2xl border border-white/10 bg-black/40 px-4 py-3">
                <dt class="text-[10px] tracking-widest text-white/40 uppercase">Contact</dt>
                <dd class="mt-1 font-semibold text-white">
                  <a href={mailto} class="text-[#22f5ff] transition hover:text-white">
                    {SITE.email}
                  </a>
                </dd>
              </div>
            </dl>
          </div>
          <div class="flex flex-col items-stretch gap-4">
            <AcquisitionCTA
              label="MAKE AN OFFER"
              variant="gradient"
              class="!w-full !px-8 !py-5 !text-lg"
              subject="aiwaitress.com — Domain Acquisition Request"
            />
            <a
              href={mailto}
              class="flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-black/50 px-6 py-4 text-sm text-white/70 transition hover:border-[#22f5ff]/40 hover:text-white"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              <span>Email {SITE.email}</span>
            </a>
            <p class="text-center text-[11px] tracking-wide text-white/40">
              Confidential inquiries • Response within 24 hours • Escrow protected
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl border-t border-white/10 px-6 py-8">
    <p class="text-xs leading-relaxed text-white/40">
      This website is for demonstration and informational purposes only. It does not constitute an offer of
      services, a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to
      specific technologies are based on publicly available information as of {SITE.asOfDate} and are subject to
      change.
    </p>
    <div
      class="mt-6 flex flex-col items-center justify-between gap-4 text-xs text-white/40 md:flex-row"
    >
      <div>&copy; {SITE.year} {SITE.name} &mdash; Premium Domain Asset</div>
      <div class="text-[10px] tracking-wide">Available for immediate registration &amp; transfer</div>
    </div>
  </div>
</footer>
