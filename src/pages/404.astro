---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 • aiwaitress.com" noindex={true}>
  <main class="flex min-h-screen items-center justify-center px-6">
    <div class="text-center">
      <h1 class="font-display text-8xl tracking-tighter text-white">404</h1>
      <p class="mt-4 text-xl text-white/50">Page not found</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-x-3 rounded-3xl bg-white px-8 py-4 text-sm font-extrabold text-[#0a0a0f] transition-all hover:bg-white/90"
      >
        Back to aiwaitress.com
      </a>
    </div>
  </main>
</BaseLayout>
