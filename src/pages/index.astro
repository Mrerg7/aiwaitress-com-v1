---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import MobileCTA from '../components/MobileCTA.astro';
import { HERO_IMAGE_URL, HERO_IMAGE_DIMENSIONS, SITE } from '../consts';
import { FAQS } from '../data/faqs';

const [features, useCases] = await Promise.all([
  getCollection('features'),
  getCollection('useCases'),
]);

const sortByOrder = <T extends { data: { order: number } }>(items: T[]) =>
  [...items].sort((a, b) => a.data.order - b.data.order);

const sortedFeatures = sortByOrder(features);
const sortedUseCases = sortByOrder(useCases);

const colorMap: Record<string, { bg: string; stroke: string; text: string }> = {
  cyan: { bg: 'bg-[#22f5ff]/10', stroke: '#22f5ff', text: 'text-[#22f5ff]' },
  purple: { bg: 'bg-[#a855f7]/10', stroke: '#a855f7', text: 'text-[#a855f7]' },
  emerald: { bg: 'bg-emerald-400/10', stroke: '#34d399', text: 'text-emerald-400' },
};
---

<BaseLayout>
  <Nav />
  <MobileCTA />

  <main>
    <!-- Hero Section -->
    <section class="relative flex min-h-screen items-center overflow-hidden pt-20">
      <img
        src={HERO_IMAGE_URL}
        alt="Premium domain aiwaitress.com — anticipatory AI service that already knows what you like"
        width={HERO_IMAGE_DIMENSIONS.width}
        height={HERO_IMAGE_DIMENSIONS.height}
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto w-full max-w-5xl px-6 pb-16 pt-12 text-center md:pt-8">
        <!-- Premium Badge -->
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 mb-8">
          <div class="w-1.5 h-1.5 bg-[#22f5ff] rounded-full animate-pulse"></div>
          <span class="text-xs font-semibold tracking-[1.5px] text-white/80">CLEVER .COM DOMAIN</span>
        </div>

        <!-- Domain Name -->
        <h1 class="domain-text font-display mb-3 tracking-[-0.07em] domain-gradient">
          aiwaitress.com
        </h1>

        <!-- Tagline -->
        <p class="max-w-2xl mx-auto text-3xl md:text-4xl font-light tracking-tight text-white/90 mb-4">
          One day AI will already know<br>
          what you like and ask if you want it.
        </p>

        <p class="max-w-lg mx-auto text-xl text-white/70 mb-10">
          Like an electronic AI Waitress.<br>
          Anticipatory. Personalized. Unforgettable.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <AcquisitionCTA
            label="Secure This Asset"
            variant="gradient"
            class="!px-9 !py-4 !text-lg"
            subject="aiwaitress.com — Claim Inquiry"
          />
          <a
            href="#concept"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-8 py-4 text-lg font-medium rounded-3xl border border-white/20 hover:bg-white/5 transition-colors"
          >
            Explore the Concept
          </a>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs text-white/55">
          <div class="flex items-center gap-x-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7" />
            </svg>
            <span>Instant Transfer</span>
          </div>
          <div>Escrow Protected</div>
          <div>Built-in SEO</div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 hidden md:block">
        <div class="flex flex-col items-center gap-y-1 text-[10px] tracking-widest text-white/55">
          <div>SCROLL TO BEGIN</div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7" />
          </svg>
        </div>
      </div>
    </section>

    <!-- The Concept Section -->
    <section id="concept" class="max-w-5xl mx-auto px-6 pt-20 pb-16">
      <div class="grid md:grid-cols-12 gap-x-12 items-center">
        <div class="md:col-span-7">
          <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">THE CONCEPT</div>

          <h2 class="section-header tracking-[-0.04em] leading-none mb-7">
            The AI that already<br>
            knows what you want.
          </h2>

          <div class="space-y-6 text-lg text-white/80 max-w-[42ch]">
            <p>
              Imagine walking into a restaurant, café, or digital experience and the system already knows your preferences — your usual order, dietary needs, favorite flavors, even your mood that day.
            </p>
            <p>
              It doesn't wait for you to ask. It gently offers: <span class="italic">"Your usual matcha oat milk latte with an extra shot? Or would you like to try the new seasonal one we think you'll love?"</span>
            </p>
            <p class="text-white/70">
              <span class="font-semibold text-white">aiwaitress.com</span> is the perfect, memorable name for this future of anticipatory, personalized AI service.
            </p>
          </div>
        </div>

        <div class="md:col-span-5 mt-10 md:mt-0">
          <div class="glass rounded-3xl p-9 md:p-10 border border-white/10">
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-[#22f5ff20] to-[#a855f720] border border-white/20 mb-6">
                <span class="font-display text-xl font-bold tracking-[-1px] bg-gradient-to-br from-[#22f5ff] to-[#a855f7] bg-clip-text text-transparent">AI</span>
              </div>

              <div class="space-y-1">
                <div class="text-3xl font-bold tracking-tighter">Waitress</div>
                <div class="text-sm text-white/60 tracking-[2px] mt-1">ANTICIPATORY • PERSONALIZED • SERVICE</div>
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 text-sm text-white/60 leading-relaxed">
                The domain that makes<br>
                personalized AI feel human.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why This Domain Section -->
    <section id="why" class="bg-white/5 border-y border-white/10 py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-3">WHY THIS DOMAIN</div>
          <h2 class="section-header tracking-[-0.03em]">Clever. Memorable. SEO-friendly.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          {
            sortedFeatures.map(({ data }) => {
              const colors = colorMap[data.color] ?? colorMap.cyan;
              return (
                <div class="modern-card glass rounded-3xl p-8 border border-white/10">
                  <div class={`w-11 h-11 rounded-2xl ${colors.bg} flex items-center justify-center mb-6`}>
                    <svg xmlns="http://www.w3.org/2000/svg" class={`w-6 h-6 ${colors.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      {data.icon === 'search' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 01-14 0 7 7 0 0114 0z" />}
                      {data.icon === 'globe' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 4.01V8" />}
                      {data.icon === 'lightning' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />}
                    </svg>
                  </div>
                  <h3 class="font-semibold text-xl tracking-tight mb-3">{data.title}</h3>
                  <p class="text-white/70 leading-relaxed">{data.description}</p>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Ideal For / Use Cases -->
    <section id="uses" class="max-w-6xl mx-auto px-6 py-20">
      <div class="max-w-2xl mb-12">
        <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">IDEAL FOR</div>
        <h2 class="section-header tracking-[-0.035em] leading-none">The perfect name for anticipatory AI.</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          sortedUseCases.map(({ data }) => (
            <div class="group p-7 rounded-3xl border border-white/10 hover:border-white/20 transition-colors bg-white/[0.015]">
              <div class="font-mono text-xs tracking-widest text-[#22f5ff] mb-2">{data.number}</div>
              <div class="font-semibold text-lg mb-2 group-hover:text-[#22f5ff] transition-colors">{data.title}</div>
              <p class="text-sm text-white/60">{data.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Poignant Closer -->
    <div class="max-w-3xl mx-auto px-6 text-center py-8 border-y border-white/10">
      <p class="text-2xl md:text-3xl font-light tracking-tight text-white/90">
        The best service doesn't wait to be asked.<br>
        <span class="font-semibold text-white">It already knows.</span>
      </p>
    </div>

    <!-- Pricing Section -->
    <section id="pricing" class="max-w-4xl mx-auto px-6 py-20">
      <div class="text-center mb-10">
        <div class="inline-block px-4 py-1 rounded-full bg-emerald-400/10 text-emerald-400 text-xs tracking-[1.5px] font-semibold mb-4">ACQUISITION</div>
        <h2 class="section-header tracking-[-0.03em]">A clever name with built-in appeal.</h2>
      </div>

      <div class="glass rounded-3xl p-7 sm:p-10 md:p-14 border border-white/10">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-y-8">
          <div>
            <div class="flex items-baseline gap-x-2">
              <span class="text-5xl font-semibold tracking-tighter sm:text-7xl">$8,888</span>
              <span class="text-white/55 text-xl">USD</span>
            </div>
            <p class="mt-1 text-white/60">One-time acquisition &bull; Full ownership &amp; instant transfer</p>

            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              <div class="flex items-center gap-x-2 text-white/70">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
                <span>Clean title, ready for transfer</span>
              </div>
              <div class="flex items-center gap-x-2 text-white/70">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
                <span>Escrow.com protected transaction</span>
              </div>
            </div>
          </div>

          <div class="md:text-right">
            <AcquisitionCTA
              label="Begin Acquisition"
              variant="primary"
              class="!w-full md:!w-auto !px-10 !py-4 !text-lg"
              subject="aiwaitress.com — Begin Acquisition"
            />
            <p class="text-xs text-white/50 mt-3 md:mt-2">Serious buyers only. Flexible terms available.</p>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <p class="text-xs text-white/50 max-w-md mx-auto">
          Descriptive, brandable .com domains with built-in storytelling and SEO value are increasingly rare.
          This asset combines cleverness, memorability, and real-world applicability.
        </p>
      </div>

      <div id="domain-assessment" class="mt-10 glass rounded-3xl p-8 md:p-10 border border-white/10">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-xl">
            <p class="text-xs font-semibold tracking-[1.5px] text-white/60 mb-2">DOMAIN ASSESSMENT</p>
            <h3 class="text-2xl font-semibold tracking-tight mb-3">Broker editorial review</h3>
            <p class="text-white/70 leading-relaxed">
              Premium .com combining AI and hospitality semantics. Strong memorability, clear use cases across
              restaurant tech, AI concierge, and personalization platforms. Built-in SEO from descriptive keyword pairing.
            </p>
            <p class="mt-4 text-sm text-white/50">
              Desert Rich Domain Advisory &bull; Published {SITE.asOfDate}
            </p>
          </div>
          <div class="shrink-0 rounded-2xl border border-white/10 bg-black/30 px-6 py-5 text-center">
            <div class="flex items-center justify-center gap-1 text-[#22f5ff]" aria-label="5 out of 5 stars">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))
              }
            </div>
            <p class="mt-2 text-3xl font-semibold tracking-tight">5.0</p>
            <p class="text-sm text-white/50">1 editorial review</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white/5 border-y border-white/10 py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12">
          <div class="inline-block px-4 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-3">FAQ</div>
          <h2 class="section-header tracking-[-0.03em]">Questions buyers ask first.</h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {
            FAQS.map(({ question, answer }) => (
              <div class="glass rounded-3xl p-7 border border-white/10">
                <h3 class="font-semibold text-lg tracking-tight mb-2">{question}</h3>
                <p class="text-[15px] leading-relaxed text-white/70">{answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Inquiry / Contact Section -->
    <section id="inquire" class="bg-white/5 py-16">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-10">
          <h2 class="text-4xl font-semibold tracking-tight">Ready to own the AI Waitress?</h2>
          <p class="mt-3 text-white/70">Submit your inquiry. We respond personally to serious buyers within 24 hours.</p>
        </div>

        <form id="inquiry-form" class="glass rounded-3xl p-8 md:p-10 border border-white/10 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">FULL NAME</label>
              <input type="text" id="name" required
                     class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-3.5 text-white placeholder:text-white/50">
            </div>
            <div>
              <label for="email" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">EMAIL ADDRESS</label>
              <input type="email" id="email" required
                     class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-3.5 text-white placeholder:text-white/50">
            </div>
          </div>

          <div>
            <label for="org" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">ORGANIZATION OR INTENDED USE (OPTIONAL)</label>
            <input type="text" id="org"
                   class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-3.5 text-white placeholder:text-white/50">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="offer" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">YOUR OFFER (OPTIONAL)</label>
              <div class="relative">
                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-white/55">$</span>
                <input type="text" id="offer" placeholder="8888"
                       class="form-input w-full bg-white/5 border border-white/15 rounded-2xl pl-8 pr-5 py-3.5 text-white placeholder:text-white/50">
              </div>
            </div>
            <div>
              <label for="timeline" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">TIMELINE</label>
              <select id="timeline" class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 py-[15px] text-white">
                <option value="">Select preferred timeline</option>
                <option value="immediate">Immediate (within 7 days)</option>
                <option value="2weeks">Within 2 weeks</option>
                <option value="month">Within 30 days</option>
                <option value="flexible">Flexible / exploring</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">MESSAGE OR QUESTIONS</label>
            <textarea id="message" rows="4" placeholder="What is your vision for aiwaitress.com?"
                      class="form-input w-full bg-white/5 border border-white/15 rounded-3xl px-5 py-4 text-white placeholder:text-white/50 resize-y min-h-[110px]"></textarea>
          </div>

          <button type="submit"
                  class="w-full py-4 rounded-3xl bg-gradient-to-r from-[#22f5ff] to-[#a855f7] font-semibold text-[#0a0a0f] text-lg tracking-[-0.2px] active:scale-[0.985] transition-all hover:brightness-105">
            Submit Secure Inquiry
          </button>

          <p class="text-center text-[10px] text-white/50 tracking-wide">Your information is kept confidential. All transactions protected via escrow.</p>
        </form>

        <!-- Success Message -->
        <div id="success-message" class="hidden mt-6 glass rounded-3xl p-8 border border-emerald-400/30 text-center">
          <div class="mx-auto w-14 h-14 rounded-full bg-emerald-400/10 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21V3" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold tracking-tight mb-2">Your email app is opening</h3>
          <p class="text-white/70 max-w-sm mx-auto">
            We pre-filled an email with your inquiry. Press <span class="font-semibold text-white">Send</span> there and
            it reaches us directly — we reply to serious buyers within 24 hours.
          </p>
          <p class="mt-3 text-sm text-white/55">
            Nothing opened?
            <a id="retry-mail" href="mailto:sales@desertrich.com" class="font-medium text-[#22f5ff] underline underline-offset-4">Click here to email us</a>
          </p>
          <button id="reset-form-btn" type="button"
                  class="mt-6 text-sm font-medium text-white/60 hover:text-white underline underline-offset-4">Submit another inquiry</button>
        </div>
      </div>
    </section>

    <!-- Trust / Footer Bar -->
    <div class="border-t border-white/10 py-5">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-y-3 text-xs text-white/50">
        <div>Transactions secured via <span class="font-medium text-white/70">Escrow.com</span> &bull; Premium domain brokerage</div>
        <div>&copy; {SITE.year} {SITE.name} &bull; All rights reserved</div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form');
  const successMsg = document.getElementById('success-message');
  const resetBtn = document.getElementById('reset-form-btn');
  const retryMail = document.getElementById('retry-mail');

  const field = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null)?.value?.trim() || '';

  function buildMailto(): string {
    const body = [
      'Hello,',
      '',
      'I would like to inquire about acquiring aiwaitress.com.',
      '',
      `Name: ${field('name')}`,
      `Email: ${field('email')}`,
      `Organization / intended use: ${field('org') || '—'}`,
      `Offer (USD): ${field('offer') || '—'}`,
      `Timeline: ${field('timeline') || '—'}`,
      '',
      'Message:',
      field('message') || '—',
      '',
      'Thank you,',
    ].join('\n');

    const subject = 'aiwaitress.com — Domain Acquisition Inquiry';
    return `mailto:sales@desertrich.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  function showSuccess() {
    if (!form || !successMsg) return;
    const href = buildMailto();
    if (retryMail) retryMail.setAttribute('href', href);
    form.style.display = 'none';
    successMsg.classList.remove('hidden');
    successMsg.classList.add('block');
    window.location.href = href;
  }

  function resetForm() {
    if (!form || !successMsg) return;
    successMsg.classList.add('hidden');
    successMsg.classList.remove('block');
    form.style.display = 'block';
    form.reset();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Secure Inquiry';
    }
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.textContent = 'Opening your email…';
        submitBtn.disabled = true;
      }
      showSuccess();
    });
  }

  resetBtn?.addEventListener('click', resetForm);

  // Hide the sticky mobile CTA while the inquiry form is on screen so it
  // never covers the submit button or competes with the form.
  const inquireSection = document.getElementById('inquire');
  const mobileCta = document.getElementById('mobile-cta');
  if (inquireSection && mobileCta && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        mobileCta.classList.toggle('translate-y-full', entry.isIntersecting);
      },
      { threshold: 0.05 },
    );
    observer.observe(inquireSection);
  }

  // Keyboard accessibility
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        document.getElementById('mobile-menu-button')?.setAttribute('aria-expanded', 'false');
      }
    }
  });
</script>
