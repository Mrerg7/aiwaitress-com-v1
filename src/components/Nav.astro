---
import AcquisitionCTA from './AcquisitionCTA.astro';
---

<nav class="fixed top-0 right-0 left-0 z-50 transition-all duration-300 border-b border-white/5" id="nav">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 h-20">
    <a href="/" class="flex items-center gap-x-3" aria-label="aiwaitress.com home">
      <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-[#22f5ff] via-[#a855f7] to-[#22f5ff] p-px">
        <div class="w-full h-full bg-[#0a0a0f] rounded-2xl flex items-center justify-center">
          <span class="text-[#22f5ff] text-xl font-bold tracking-tighter">AI</span>
        </div>
      </div>
      <div class="font-display text-2xl font-semibold tracking-tighter">aiwaitress.com</div>
    </a>

    <div class="hidden items-center gap-x-9 text-sm font-medium md:flex">
      <a href="#concept" class="text-white/80 hover:text-[#22f5ff] transition-all">The Concept</a>
      <a href="#why" class="text-white/80 hover:text-[#22f5ff] transition-all">Why This Domain</a>
      <a href="#uses" class="text-white/80 hover:text-[#22f5ff] transition-all">Ideal For</a>
      <a href="#pricing" class="text-white/80 hover:text-[#22f5ff] transition-all">Pricing</a>
    </div>

    <div class="flex items-center gap-x-3">
      <a
        href="#inquire"
        class="hidden items-center gap-x-2 rounded-2xl border border-white/20 px-6 py-2.5 text-sm font-semibold transition-all hover:bg-white/5 sm:inline-flex"
      >
        Inquire
      </a>
      <AcquisitionCTA
        label="Secure Now"
        variant="primary"
        class="!px-6 !py-2.5 !text-sm"
        subject="aiwaitress.com — Acquisition Inquiry"
      />
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('nav-scrolled', window.scrollY > 60);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
